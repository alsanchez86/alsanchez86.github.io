---
import { getTranslation } from '@i18n/utils';

export { getStaticPaths } from '@i18n/utils';

const { t } = Astro.locals;
const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<section id="contact" class="section-wrapper">
  <div class="container container-narrow">
    <header>
      <h2 class="section-title">{getTranslation(t, 'contact')}</h2>
    </header>

    <div class="row">
      <div class="col-12 col-md-7">
        <div class="contact-form">
          <form
            id="contact-form"
            action="https://api.web3forms.com/submit"
            method="POST"
          >
            <input type="hidden" name="access_key" value={web3FormsKey} />

            <input
              class="d-none"
              type="checkbox"
              name="botcheck"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />

            <div class="form-group">
              <label for="contact-form-name">
                {getTranslation(t, 'contactFormName')}
                &nbsp;
                <small class="text-muted">
                  <i>({getTranslation(t, 'contactFormFieldsRequired')})</i>
                </small>
              </label>

              <input
                id="contact-form-name"
                type="text"
                class="form-control"
                name="name"
                maxlength="100"
                placeholder={getTranslation(t, 'contactFormNamePlaceholder')}
                required
              />
            </div>

            <div class="form-group">
              <label for="contact-form-email">
                {getTranslation(t, 'contactFormEmail')}
                &nbsp;
                <small class="text-muted">
                  <i>({getTranslation(t, 'contactFormFieldsRequired')})</i>
                </small>
              </label>

              <input
                id="contact-form-email"
                type="email"
                class="form-control"
                name="email"
                maxlength="254"
                placeholder={getTranslation(t, 'contactFormEmailPlaceholder')}
                required
              />
            </div>

            <div class="form-group">
              <label for="contact-form-message">
                {getTranslation(t, 'contactFormMessage')}
                &nbsp;
                <small class="text-muted">
                  <i>({getTranslation(t, 'contactFormFieldsRequired')})</i>
                </small>
              </label>

              <textarea
                id="contact-form-message"
                class="form-control"
                name="message"
                rows="4"
                maxlength="2000"
                placeholder={getTranslation(t, 'contactFormMessagePlaceholder')}
                required
              ></textarea>
            </div>

            <div class="form-group">
              <div class="d-flex justify-content-end">
                <button
                  id="contact-form-submit-btn"
                  type="submit"
                  class="btn btn-primary"
                  disabled
                >
                  {getTranslation(t, 'contactFormSubmit')}
                </button>
              </div>
            </div>

            <div
              id="contact-form-status-success"
              class="d-none alert alert-success alert-dismissible"
              role="alert"
              aria-live="polite"
            >
              {getTranslation(t, 'contactFormSuccess')}

              <button
                id="contact-form-status-error-success-close"
                type="button"
                class="btn btn-text close"
                aria-label="Close"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  fill="currentColor"
                  class="main-nav-toggle-button-close bi bi-x-square"
                  viewBox="0 0 16 16"
                >
                  <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z" />
                  <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708" />
                </svg>
              </button>
            </div>

            <div
              id="contact-form-status-error"
              class="d-none alert alert-danger alert-dismissible"
              role="alert"
              aria-live="polite"
            >
              {getTranslation(t, 'contactFormError')}
              &nbsp;
              <span id="contact-form-fallback-email"></span>
              <button
                id="contact-form-status-error-btn-close"
                type="button"
                class="btn-text close"
                aria-label="Close"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  fill="currentColor"
                  class="main-nav-toggle-button-close bi bi-x-square"
                  viewBox="0 0 16 16"
                >
                  <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z" />
                  <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708" />
                </svg>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const MIN_SUBMIT_DELAY_MS = 2500;
  const MAX_NAME_LENGTH = 100;
  const MAX_EMAIL_LENGTH = 254;
  const MAX_MESSAGE_LENGTH = 2000;

  initForm();
  document.addEventListener('astro:page-load', initForm);

  /**
   * Finds the contact form in the DOM and initializes it once per page load.
   */
  function initForm() {
    const form = document.getElementById(
      'contact-form',
    ) as HTMLFormElement | null;

    if (form && form.dataset.initialized !== 'true') {
      form.dataset.initialized = 'true';
      setupForm(form);
    }
  }

  /**
   * Binds validation, anti-spam checks, alert dismissal, and async submission
   * handlers to the contact form.
   *
   * @param form The contact form element to configure.
   */
  function setupForm(form: HTMLFormElement) {
    let loadedAt = Date.now();

    const nameInput = document.getElementById(
      'contact-form-name',
    ) as HTMLInputElement;
    const emailInput = document.getElementById(
      'contact-form-email',
    ) as HTMLInputElement;
    const messageInput = document.getElementById(
      'contact-form-message',
    ) as HTMLTextAreaElement;
    const submitBtn = document.getElementById(
      'contact-form-submit-btn',
    ) as HTMLButtonElement;
    const statusSuccess = document.getElementById(
      'contact-form-status-success',
    ) as HTMLDivElement;
    const statusError = document.getElementById(
      'contact-form-status-error',
    ) as HTMLDivElement;
    const statusErrorBtnClose = document.getElementById(
      'contact-form-status-error-btn-close',
    ) as HTMLButtonElement;
    const statusSuccessBtnClose = document.getElementById(
      'contact-form-status-error-success-close',
    ) as HTMLButtonElement;
    const fallbackEmailContainer = document.getElementById(
      'contact-form-fallback-email',
    ) as HTMLSpanElement;

    statusErrorBtnClose?.addEventListener('click', clearStatus);
    statusSuccessBtnClose?.addEventListener('click', clearStatus);

    [nameInput, emailInput, messageInput].forEach((field) => {
      const handleFieldUpdate = () => {
        validateForm();
        clearStatus();
      };

      field.addEventListener('input', handleFieldUpdate);
      field.addEventListener('change', handleFieldUpdate);
    });

    form.addEventListener('submit', async (event: SubmitEvent) => {
      event.preventDefault();

      const formData = new FormData(form);
      const isHumanSubmission =
        Date.now() - loadedAt >= MIN_SUBMIT_DELAY_MS &&
        !formData.get('botcheck');

      if (isHumanSubmission) {
        await submitContactForm(formData);
      }
    });

    /**
     * Sends the form payload to Web3Forms and updates the UI according to the response.
     *
     * @param formData Collected form entries to submit.
     */
    async function submitContactForm(formData: FormData) {
      clearStatus();
      submitBtn.disabled = true;

      try {
        const payload = Object.fromEntries(formData.entries());
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(payload),
        });
        const data = await response.json();

        if (response.ok && data.success) {
          showStatus('success');
          form.reset();
          loadedAt = Date.now();
        } else {
          throw new Error();
        }
      } catch {
        showStatus('error');
      } finally {
        validateForm();
      }
    }

    /**
     * Validates required fields and length constraints, toggling the submit button state.
     */
    function validateForm() {
      const nameLength = nameInput.value.trim().length;
      const emailLength = emailInput.value.trim().length;
      const messageLength = messageInput.value.trim().length;
      const isNameValid = nameLength > 0 && nameLength <= MAX_NAME_LENGTH;
      const isMessageValid =
        messageLength > 0 && messageLength <= MAX_MESSAGE_LENGTH;
      const isEmailValid =
        emailLength > 0 &&
        emailLength <= MAX_EMAIL_LENGTH &&
        emailInput.checkValidity();

      submitBtn.disabled = !(isNameValid && isEmailValid && isMessageValid);
    }

    /**
     * Builds and appends the fallback `mailto:` link into the error alert container
     * to keep the address out of the initial static HTML.
     */
    function injectFallbackEmail() {
      const user = 'sanchezpizarro86';
      const domain = 'gmail.com';
      const email = `${user}@${domain}`;

      const link = document.createElement('a');
      link.href = `mailto:${email}`;
      link.title = 'Email';
      link.textContent = email;

      fallbackEmailContainer.appendChild(link);
    }

    /**
     * Displays the feedback alert corresponding to the submission outcome.
     *
     * @param type Outcome status to display (`'success'` or `'error'`).
     */
    function showStatus(type: 'success' | 'error') {
      if (type === 'success') {
        statusSuccess.classList.remove('d-none');
      } else {
        if (fallbackEmailContainer && !fallbackEmailContainer.hasChildNodes()) {
          injectFallbackEmail();
        }

        statusError.classList.remove('d-none');
      }
    }

    /**
     * Hides both success and error feedback alerts.
     */
    function clearStatus() {
      statusSuccess.classList.add('d-none');
      statusError.classList.add('d-none');
    }
  }
</script>
