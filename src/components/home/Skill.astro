---
import { getTranslation } from '@/i18n/utils';
import type { Skill } from '@data/skill';

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;
const { t } = Astro.locals;
const skillName = getTranslation(t, skill.name);
---

<article
  class:list={[
    'progress-item',
    { 'progress-item-is-important': skill.isImportant },
  ]}
>
  <div class="progress-header">
    <span class="progress-icon" set:html={skill.icon} />

    <header class="progress-name">{skillName}</header>
  </div>

  <div class="progress">
    <div
      class="progress-bar"
      role="progressbar"
      tabindex="0"
      aria-valuenow={skill.value}
      aria-valuemin="0"
      aria-valuemax="100"
      style={`width: ${skill.value}%`}
      title={skillName}
      data-toggle="popover"
      data-content={getTranslation(t, skill.description)}
      data-trigger="hover focus"
      data-custom-class={skill.isImportant ? 'popover-primary' : undefined}
    >
      <small class="progress-value">{skill.value}</small>
    </div>
  </div>
</article>
