---
import { Image } from 'astro:assets';
import profilePicture from '@assets/profile-picture-bw.png';
import Social from '@/components/Social.astro';
import { getTranslation } from '@i18n/utils';

export { getStaticPaths } from '@i18n/utils';

const { t } = Astro.locals;
---

<section id="about" class="about-wrapper section-wrapper">
  <div class="container container-narrow">
    <div class="row">
      <div class="d-none d-lg-block col-lg-4">
        <Image
          class="avatar img-fluid"
          src={profilePicture}
          alt="Ángel Sánchez"
          aria-label="Ángel Sánchez"
          loading="eager"
        />
      </div>

      <div class="col-12 col-lg-8">
        <header class="name-wrapper">
          <h1>Ángel Sánchez</h1>

          <h2>{getTranslation(t, 'title')}</h2>
        </header>

        <Fragment set:html={getTranslation(t, 'description')} />

        <Social />
      </div>
    </div>
  </div>
</section>
