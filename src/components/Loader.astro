<div id="loader" class="loader">
  <div class="status">
    <div class="status-mes"></div>
  </div>
</div>

<script>
  const loader = document.getElementById('loader');

  if (loader) {
    loader.style.transition = 'opacity 1s ease';
    loader.style.opacity = '0';

    setTimeout(() => loader.remove(), 1000);
  }
</script>
