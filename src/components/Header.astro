---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Locale } from '@i18n/consts';
import { getCleanPath } from '@i18n/utils';

const { locale, t } = Astro.locals;
const cleanPath = getCleanPath(Astro.url.pathname);
---

<header>
  <nav>
    <h2>
      <a href={getRelativeLocaleUrl(locale, '/')}>{t('meta.title')}</a>
    </h2>

    <div>
      <a href={getRelativeLocaleUrl(locale, '/blog')}>{t('blog')}</a>
    </div>

    <div>
      {Object.values(Locale).map((code) => (
        <a
          href={getRelativeLocaleUrl(code, cleanPath)}
          aria-current={locale === code ? 'page' : undefined}
        >
          {code.toUpperCase()}
        </a>
      ))}
    </div>
  </nav>
</header>
