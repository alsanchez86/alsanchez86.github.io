---
import type { Skill } from '@data/skill';

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;
const { t } = Astro.locals;
---

<div
  class="progress-item"
  tabindex="0"
  aria-expanded="false"
  title={skill.name}
  data-toggle="popover"
  data-content={t(skill.description)}
  data-trigger="hover focus"
>
  <div class="progress-header">
    <span class="progress-icon" set:html={skill.icon} />
    <span class="progress-name">{skill.name}</span>
  </div>

  <div class="progress">
    <div
      class="progress-bar"
      role="progressbar"
      aria-valuenow={skill.value}
      aria-valuemin="0"
      aria-valuemax="100"
      style={`width: ${skill.value}%`}
    >
      <small class="progress-value">{skill.value}%</small>
    </div>
  </div>
</div>
