---
import '@styles/main.scss';
import type { ImageMetadata } from 'astro';
import FallbackImage from '@assets/blog-placeholder-1.jpg';
import { Font } from 'astro:assets';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { defaultLocale, Locale, LocaleTag } from '@i18n/consts';
import { getCleanPath, getTranslation } from '@i18n/utils';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  isTranslated?: boolean;
}

const {
  title,
  description,
  image = FallbackImage,
  isTranslated = true,
} = Astro.props;
const { t, locale } = Astro.locals;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const cleanPath = getCleanPath(Astro.url.pathname);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={getTranslation(t, 'metaTitle')}
  href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Fuentes (definidas en astro.config.mjs) -->
<Font cssVariable="--font-geist" preload />
<Font cssVariable="--font-newsreader" preload />

<!-- Canonical & SEO Multilingüe -->
<link rel="canonical" href={canonicalURL} />

{isTranslated && (
  <>
    <link
      rel="alternate"
      hreflang={Locale.En}
      href={getAbsoluteLocaleUrl(Locale.En, cleanPath)}
    />
    <link
      rel="alternate"
      hreflang={Locale.Es}
      href={getAbsoluteLocaleUrl(Locale.Es, cleanPath)}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={getAbsoluteLocaleUrl(defaultLocale, cleanPath)}
    />
  </>
)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:locale" content={LocaleTag[locale].replace('-', '_')} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.site)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
