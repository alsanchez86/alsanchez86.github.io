---
import { getTranslation } from '@/i18n/utils';
import type { Education } from '@data/education';

interface Props {
  education: Education;
}

const { education } = Astro.props;
const { t } = Astro.locals;
---

<div class="education-item">
  <small>{education.date}</small>

  <h3>{getTranslation(t, education.name)}</h3>

  <h4 class="text-compacted">{getTranslation(t, education.location)}</h4>

  <p>{getTranslation(t, education.city)}</p>
</div>
