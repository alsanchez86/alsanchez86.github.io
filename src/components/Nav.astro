---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Locale } from '@i18n/consts';
import { getCleanPath, getTranslation } from '@i18n/utils';
import Link from '@components/Link.astro';
import type { TKey } from '@/types/i18n';

interface NavAnchorItem {
  id: string;
  labelKey: TKey;
}

const { locale, t } = Astro.locals;
const cleanPath = getCleanPath(Astro.url.pathname);
const altLocale = locale === Locale.Es ? Locale.En : Locale.Es;
const navAnchors: NavAnchorItem[] = [
  { id: 'about', labelKey: 'menuAbout' },
  { id: 'skills', labelKey: 'menuSkills' },
  { id: 'experience', labelKey: 'menuExperience' },
  { id: 'education', labelKey: 'menuEducation' },
  { id: 'contact', labelKey: 'menuContact' },
];
---

<div id="main-nav" class="main-nav navbar navbar-expand">
  <div class="container container-narrow">
    <div class="main-nav-content" id="nav-content">
      <ul class="navbar-nav nav-links">
        <!-- <li class="nav-item">
          <Link class="nav-link" href={getRelativeLocaleUrl(locale, '/blog')}>
            {getTranslation(t, 'menuBlog')}
          </Link>
        </li> -->

        {navAnchors.map(({ id, labelKey }) => (
          <li class="nav-item">
            <Link
              class="nav-link"
              href={`${getRelativeLocaleUrl(locale, '/')}#${id}`}
            >
              {getTranslation(t, labelKey)}
            </Link>
          </li>
        ))}
      </ul>
    </div>

    <div class="main-nav-header">
      <ul class="navbar-nav nav-links">
        <li class="nav-item">
          <a
            class="nav-link"
            href={getRelativeLocaleUrl(altLocale, cleanPath)}
            title={getTranslation(t, 'switchLangText')}
          >
            {getTranslation(t, 'switchLangText')}
          </a>
        </li>
      </ul>

      <div class="d-block d-md-none">
        <button
          id="main-nav-toggle-button"
          class="btn btn-link"
          type="button"
          aria-label="Menu"
          aria-expanded="false"
        >
          <svg
            class="main-nav-toggle-button-open"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="currentColor"
            viewBox="0 0 16 16"
          >
            <path d="M0 1.5A1.5 1.5 0 0 1 1.5 0h2A1.5 1.5 0 0 1 5 1.5v2A1.5 1.5 0 0 1 3.5 5h-2A1.5 1.5 0 0 1 0 3.5zM1.5 1a.5.5 0 0 0-.5.5v2a.5.5 0 0 0 .5.5h2a.5.5 0 0 0 .5-.5v-2a.5.5 0 0 0-.5-.5zM0 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm1 3v2a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2zm14-1V8a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v2zM2 8.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0 4a.5.5 0 0 1 .5-.5h6a.5.5 0 0 1 0 1h-6a.5.5 0 0 1-.5-.5" />
          </svg>

          <svg
            class="main-nav-toggle-button-close"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="currentColor"
            viewBox="0 0 16 16"
          >
            <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z" />
            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const mainNav = document.getElementById('main-nav') as HTMLElement;
  const menuToggleButton = document.getElementById(
    'main-nav-toggle-button',
  ) as HTMLElement;
  const navLinks = document.querySelectorAll('#main-nav .nav-link');
  const noScrollClass = 'no-scroll';
  const isOpenClass = 'is-open';

  nav();
  document.addEventListener('astro:page-load', nav);

  /**
   * Toggles the visibility of the mobile navigation menu.
   *
   * @param event Interaction event triggered by the menu button.
   */
  function toggle(event: Event) {
    event.stopPropagation();

    const isOpen = mainNav.classList.toggle(isOpenClass);

    document.body.classList.toggle(noScrollClass, isOpen);
    menuToggleButton.setAttribute('aria-expanded', String(isOpen));
  }

  /**
   * Closes the mobile navigation menu, re-enables `body` scrolling, and updates the toggle button's accessibility state.
   */
  function close() {
    mainNav.classList.remove(isOpenClass);
    document.body.classList.remove(noScrollClass);
    menuToggleButton.setAttribute('aria-expanded', 'false');
  }

  /**
   * Registers the event listeners required to control the mobile menu (toggle button click, navigation link clicks, and closing via the `Escape` key).
   */
  function nav() {
    menuToggleButton.addEventListener('click', toggle);
    navLinks.forEach((link) => {
      link.addEventListener('click', close);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mainNav.classList.contains(isOpenClass)) {
        close();
      }
    });
  }
</script>
