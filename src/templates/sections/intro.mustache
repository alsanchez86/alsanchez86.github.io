<header class="intro-wrapper section-wrapper">
  <div class="container container-narrow">
    <div class="row">
      <div class="col-lg-4 col-xl-4 d-none d-lg-block">
        <img
          class="img-fluid"
          src="{{ img_path }}/profile-picture-bw.png"
          alt="Ángel Luis Sánchez Pizarro"
        />
      </div>

      <div class="col-12 col-lg-8 col-xl-8">
        <div class="name-wrapper">
          <h1>Ángel Sánchez</h1>

          <h2>
            {{ title }}
          </h2>
        </div>

        {{ description }}

        <div class="row">
          <div class="col-3">
            <div class="personal-detail">
              <h3>{{ dateBirth }}</h3>

              <p>
                <small>{{ dateBirthValue }}</small>
              </p>
            </div>
          </div>

          <div class="col-3">
            <div class="personal-detail">
              <h3>{{ nationality }}</h3>

              <p>
                <small>{{ nationalityValue }}</small>
              </p>
            </div>
          </div>

          <div class="col-3">
            <div class="personal-detail">
              <h3>{{ languages }}</h3>

              <p>
                <small>{{ languagesEnglish }}</small>
                <br />
                <small>{{ languagesSpanish }}</small>
              </p>
            </div>
          </div>

          <div class="col-3">
            <p>
              <a
                class="btn btn-primary"
                href="https://github.com/alsanchez86/alsanchez86.github.io/raw/master/src/files/cv-angel-sanchez.pdf"
                target="_blank"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  fill="currentColor"
                  class="bi bi-arrow-bar-down"
                  viewBox="0 0 16 16"
                >
                  <path
                    fill-rule="evenodd"
                    d="M1 3.5a.5.5 0 0 1 .5-.5h13a.5.5 0 0 1 0 1h-13a.5.5 0 0 1-.5-.5M8 6a.5.5 0 0 1 .5.5v5.793l2.146-2.147a.5.5 0 0 1 .708.708l-3 3a.5.5 0 0 1-.708 0l-3-3a.5.5 0 0 1 .708-.708L7.5 12.293V6.5A.5.5 0 0 1 8 6"
                  />
                </svg>
                Resume
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
