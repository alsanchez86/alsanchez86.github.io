<section id="skills" class="section-wrapper">
  <div class="container container-narrow">
    <h2 class="section-title">{{ skillsTitle }}</h2>

    <div class="skills-grid">
      <div id="skills-item-frontend" class="skills-item skills-item-frontend">
        <h4>Frontend</h4>
        {{#skills.frontend}}
        {{>skills_item}}
        {{/skills.frontend}}
      </div>

      <div id="skills-item-backend" class="skills-item skills-item-backend">
        <h4>Backend</h4>
        {{#skills.backend}}
        {{>skills_item}}
        {{/skills.backend}}
      </div>

      <div id="skills-item-sistemas" class="skills-item skills-item-sistemas">
        <h4>{{ systems }}</h4>
        {{#skills.systems}}
        {{>skills_item}}
        {{/skills.systems}}
      </div>

      <div id="skills-item-versiones" class="skills-item skills-item-versiones">
        <h4>{{ versionsManagers }}</h4>
        {{#skills.versions}}
        {{>skills_item}}
        {{/skills.versions}}
      </div>

      <div
        id="skills-item-dependencias"
        class="skills-item skills-item-dependencias"
      >
        <h4>{{ dependencyManagers }}</h4>
        {{#skills.dependencies}}
        {{>skills_item}}
        {{/skills.dependencies}}
      </div>

      <div id="skills-item-otros" class="skills-item skills-item-otros">
        <h4>{{ otherTechnologies }}</h4>
        {{#skills.others}}
        {{>skills_item}}
        {{/skills.others}}
      </div>

      <div id="skills-item-design" class="skills-item skills-item-design">
        <h4>{{ graphicDesign }}</h4>
        {{#skills.dessign}}
        {{>skills_item}}
        {{/skills.dessign}}
      </div>

      <div
        id="skills-item-despliegues"
        class="skills-item skills-item-despliegues"
      >
        <h4>{{ deployments }}</h4>
        {{#skills.updates}}
        {{>skills_item}}
        {{/skills.updates}}
      </div>

      <div id="skills-item-ma" class="skills-item skills-item-ma">
        <h4>{{ agileMethodologies }}</h4>
        {{#skills.agile}}
        {{>skills_item}}
        {{/skills.agile}}
      </div>
    </div>
  </div>
</section>
