<section id="skills" class="section-wrapper">
  <div class="container container-narrow">
    <h2 class="section-title">{{ skillsTitle }}</h2>

    <div id="skills-accordion" class="skills-grid">
      <div class="skills-item">
        <h4 class="text-compacted">Frontend</h4>
        {{#skills.frontend}}
        {{>skills_item}}
        {{/skills.frontend}}
      </div>

      <div class="skills-item">
        <h4 class="text-compacted">Backend</h4>
        {{#skills.backend}}
        {{>skills_item}}
        {{/skills.backend}}
      </div>

      <div class="skills-item">
        <h4 class="text-compacted">{{ systems }}</h4>
        {{#skills.systems}}
        {{>skills_item}}
        {{/skills.systems}}
      </div>

      <div class="skills-item">
        <h4 class="text-compacted">{{ versionsManagers }}</h4>
        {{#skills.versions}}
        {{>skills_item}}
        {{/skills.versions}}
      </div>

      <div class="skills-item">
        <h4 class="text-compacted">{{ dependencyManagers }}</h4>
        {{#skills.dependencies}}
        {{>skills_item}}
        {{/skills.dependencies}}
      </div>

      <div class="skills-item">
        <h4 class="text-compacted">{{ otherTechnologies }}</h4>
        {{#skills.others}}
        {{>skills_item}}
        {{/skills.others}}
      </div>

      <div class="skills-item">
        <h4 class="text-compacted">{{ graphicDesign }}</h4>
        {{#skills.dessign}}
        {{>skills_item}}
        {{/skills.dessign}}
      </div>

      <div class="skills-item">
        <h4 class="text-compacted">{{ deployments }}</h4>
        {{#skills.deployments}}
        {{>skills_item}}
        {{/skills.deployments}}
      </div>

      <div class="skills-item">
        <h4 class="text-compacted">{{ agileMethodologies }}</h4>
        {{#skills.agile}}
        {{>skills_item}}
        {{/skills.agile}}
      </div>
    </div>
  </div>
</section>
