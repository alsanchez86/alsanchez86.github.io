<div class="progress-item">
  <div class="progress-item-icon">{{{ icon }}}</div>

  <div class="progress-title">
    <span class="progress-name">{{ name }}</span>
    <small class="progress-value" style="left: {{ value }}%"
      >{{ value }}%</small
    >
  </div>

  <div class="progress">
    <div
      class="progress-bar"
      role="progressbar"
      aria-valuenow="{{ value }}"
      aria-valuemin="0"
      aria-valuemax="100"
      style="width: {{ value }}%"
    ></div>
  </div>
</div>
