<div
  class="progress-item"
  role="button"
  aria-expanded="false"
  aria-controls="collapse-{{ index }}"
  data-toggle="collapse"
  data-target="#collapse-{{ index }}"
>
  <div class="progress-header">
    <span class="progress-icon">{{{ icon }}}</span>
    <span class="progress-name">{{ name }}</span>
  </div>

  <div class="progress">
    <div
      class="progress-bar"
      role="progressbar"
      aria-valuenow="{{ value }}"
      aria-valuemin="0"
      aria-valuemax="100"
      style="width: {{ value }}%"
    >
      <small class="progress-value">{{ value }}%</small>
    </div>
  </div>
</div>

<div id="collapse-{{ index }}" class="collapse progress-item-collapse">
  <div class="card card-body">
    {{ name }}
  </div>
</div>
