<div
  class="progress-item"
  tabindex="0"
  aria-expanded="false"
  title="{{ name }}"
  data-toggle="popover"
  data-content="{{ description }}"
  data-trigger="hover focus"
>
  <div class="progress-header">
    <span class="progress-icon">{{{ icon }}}</span>
    <span class="progress-name">{{ name }}</span>
  </div>

  <div class="progress">
    <div
      class="progress-bar"
      role="progressbar"
      aria-valuenow="{{ value }}"
      aria-valuemin="0"
      aria-valuemax="100"
      style="width: {{ value }}%"
    >
      <small class="progress-value">{{ value }}%</small>
    </div>
  </div>
</div>
