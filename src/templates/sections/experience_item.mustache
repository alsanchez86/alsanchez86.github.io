<div class="experience-item">
  <div class="row">
    <div class="col-9">
      <div class="experience-item-header">
        {{#company_link}}
        <h3>
          <a href="{{ link }}" target="_blank">
            {{ name }}
          </a>
        </h3>
        {{/company_link}}

        <p>
          {{ position }}
          <br />
          <small>{{ date }}. {{ city }}</small>
        </p>
      </div>

      <div class="experience-description">
        {{ description }}
      </div>

      <div class="experience-item-batch">
        {{#techs}}
        {{#items}}
        <span class="badge experience-item-batch-{{ type }}">{{ name }}</span>
        {{/items}}
        {{/techs}}
      </div>
    </div>

    <div class="col-3"></div>
  </div>
</div>
