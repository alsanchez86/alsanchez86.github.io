---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '@layouts/BaseLayout.astro';
import Date from '@components/Date.astro';
import { getTranslation } from '@i18n/utils';
import SkillBadge from '@/components/SkillBadge.astro';

export { getStaticPaths } from '@i18n/utils';

const { locale, t } = Astro.locals;
const posts = (
  await getCollection('blog', ({ id }) => id.startsWith(`${locale}/`))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title={getTranslation(t, 'metaTitle')}
  description={getTranslation(t, 'metaDescription')}
>
  <section id="blog" class="blog-wrapper section-wrapper">
    <div class="container container-narrow">
      <header>
        <h1 class="section-title">
          {getTranslation(t, 'blogTitle')}{' '}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="currentColor"
            class="bi bi-rss-fill"
            viewBox="0 0 16 16"
          >
            <path d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zm1.5 2.5c5.523 0 10 4.477 10 10a1 1 0 1 1-2 0 8 8 0 0 0-8-8 1 1 0 0 1 0-2m0 4a6 6 0 0 1 6 6 1 1 0 1 1-2 0 4 4 0 0 0-4-4 1 1 0 0 1 0-2m.5 7a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3" />
          </svg>
        </h1>
      </header>

      {posts.map((post) => {
        const slug = post.id.replace(`${locale}/`, '');
        const postUrl = getRelativeLocaleUrl(locale, `/blog/${slug}`);

        return (
          <article>
            <a class="post" href={postUrl}>
              <div class="post-metadata">
                <small>
                  <Date date={post.data.date} />
                </small>

                <small>Tiempo de lectura: 5 min.</small>
              </div>

              <header>
                <h3 class="post-title">
                  {post.data.title}&nbsp;
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    fill="currentColor"
                    class="bi bi-arrow-right-short"
                    viewBox="0 0 16 16"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M4 8a.5.5 0 0 1 .5-.5h5.793L8.146 5.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L10.293 8.5H4.5A.5.5 0 0 1 4 8"
                    />
                  </svg>
                </h3>
              </header>

              <p>{post.data.description}</p>

              <div class="skill-item-batch">
                {post.data.skills.map((name) => (
                  <SkillBadge name={name} />
                ))}
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
