---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import profilePicture from '@assets/profile-picture-bw.png';
import { skills } from '@data/skill';
import Skill from '@components/Skill.astro';
import { experiences } from '@data/experience';
import Experience from '@components/Experience.astro';
import { educations } from '@data/education';
import Education from '@components/Education.astro';
import Divider from '@/components/Divider.astro';
import { getTranslation } from '@i18n/utils';

export { getStaticPaths } from '@i18n/utils';

const { t } = Astro.locals;
---

<BaseLayout
  title={getTranslation(t, 'meta.title')}
  description={getTranslation(t, 'meta.description')}
>
  <section id="about" class="intro-wrapper section-wrapper">
    <div class="container container-narrow">
      <div class="row">
        <div class="d-none d-lg-block col-lg-4">
          <Image class="img-fluid" src={profilePicture} alt="Ángel Sánchez" />
        </div>

        <div class="col-12 col-lg-8">
          <header class="name-wrapper">
            <h1>Ángel Sánchez</h1>

            <h2>{getTranslation(t, 'title')}</h2>
          </header>

          <Fragment set:html={getTranslation(t, 'description')} />

          <div class="row">
            <div class="col-4 col-sm-3">
              <div class="personal-detail">
                <h4 class="text-compacted">{getTranslation(t, 'languages')}</h4>

                <p>
                  <small>{getTranslation(t, 'languagesEnglish')}</small>
                  <br />
                  <small>{getTranslation(t, 'languagesSpanish')}</small>
                </p>
              </div>
            </div>

            <div class="col-4 col-sm-3">
              <div class="personal-detail">
                <h4 class="text-compacted">
                  {getTranslation(t, 'nationality')}
                </h4>

                <p>
                  <small>{getTranslation(t, 'nationalityValue')}</small>
                </p>
              </div>
            </div>

            <div class="col-4 col-sm-3">
              <div class="personal-detail">
                <h4 class="text-compacted">{getTranslation(t, 'dateBirth')}</h4>

                <p>
                  <small>{getTranslation(t, 'dateBirthValue')}</small>
                </p>
              </div>
            </div>

            <div class="d-none d-md-block col-sm-3"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Divider variant={1} />

  <section id="skills" class="section-wrapper">
    <div class="container container-narrow">
      <header>
        <h2 class="section-title">{getTranslation(t, 'skillsTitle')}</h2>
      </header>

      <div class="skills-grid">
        {skills.map(({ type, items }) => (
          <div class="skills-item">
            <h4 class="text-compacted">{getTranslation(t, type)}</h4>

            {items.map((skill) => (
              <Skill skill={skill} />
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <Divider variant={2} />

  <section id="experience" class="section-wrapper">
    <div class="container container-narrow">
      <header>
        <h2 class="section-title">{getTranslation(t, 'experienceTitle')}</h2>
      </header>

      {experiences.map((experience) => (
        <Experience experience={experience} />
      ))}
    </div>
  </section>

  <Divider variant={3} />

  <section id="education" class="section-wrapper">
    <div class="container container-narrow">
      <header>
        <h2 class="section-title">{getTranslation(t, 'educationTitle')}</h2>
      </header>

      {educations.map((education) => (
        <Education education={education} />
      ))}
    </div>
  </section>

  <Divider variant={4} />

  <section id="contact" class="section-wrapper">
    <div class="container container-narrow">
      <header>
        <h2 class="section-title">{getTranslation(t, 'contact')}</h2>
      </header>

      <div class="row">
        <div class="col-12 col-md-6">
          <div class="contact-form">
            <form
              id="contact-form"
              action="https://api.web3forms.com/submit"
              method="POST"
            >
              <input
                type="hidden"
                name="access_key"
                value="9a6335de-2fb4-45fa-9016-82903a54e52e"
              />
              <input type="checkbox" name="botcheck" class="d-none" />

              <div class="form-group">
                <label for="contact-form-name">
                  {getTranslation(t, 'contactFormName')}
                  &nbsp;
                  <small class="text-muted">
                    <i>({getTranslation(t, 'contactFormFieldsRequired')})</i>
                  </small>
                </label>

                <input
                  id="contact-form-name"
                  type="text"
                  class="form-control"
                  name="name"
                  placeholder={getTranslation(t, 'contactFormNamePlaceholder')}
                  required
                />
              </div>

              <div class="form-group">
                <label for="contact-form-email">
                  {getTranslation(t, 'contactFormEmail')}
                  &nbsp;
                  <small class="text-muted">
                    <i>({getTranslation(t, 'contactFormFieldsRequired')})</i>
                  </small>
                </label>

                <input
                  id="contact-form-email"
                  type="email"
                  class="form-control"
                  name="email"
                  placeholder={getTranslation(t, 'contactFormEmailPlaceholder')}
                  required
                />
              </div>

              <div class="form-group">
                <label for="contact-form-message">
                  {getTranslation(t, 'contactFormMessage')}
                  &nbsp;
                  <small class="text-muted">
                    <i>({getTranslation(t, 'contactFormFieldsRequired')})</i>
                  </small>
                </label>

                <textarea
                  id="contact-form-message"
                  class="form-control"
                  name="message"
                  rows="4"
                  placeholder={getTranslation(
                    t,
                    'contactFormMessagePlaceholder',
                  )}
                  required
                ></textarea>
              </div>

              <div class="form-group">
                <div class="d-flex justify-content-end">
                  <button
                    id="contact-form-submit-btn"
                    type="submit"
                    class="btn btn-primary"
                    disabled
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      fill="currentColor"
                      class="bi bi-send-fill"
                      viewBox="0 0 16 16"
                    >
                      <path d="M15.964.686a.5.5 0 0 0-.65-.65L.767 5.855H.766l-.452.18a.5.5 0 0 0-.082.887l.41.26.001.002 4.995 3.178 3.178 4.995.002.002.26.41a.5.5 0 0 0 .886-.083zm-1.833 1.89L6.637 10.07l-.215-.338a.5.5 0 0 0-.154-.154l-.338-.215 7.494-7.494 1.178-.471z" />
                    </svg>
                    &nbsp;{getTranslation(t, 'contactFormSubmit')}
                  </button>
                </div>
              </div>

              <div
                id="contact-form-status-success"
                class="d-none alert alert-success alert-dismissible"
                role="alert"
                aria-live="polite"
              >
                {getTranslation(t, 'contactFormSuccess')}

                <button
                  id="contact-form-status-error-success-close"
                  type="button"
                  class="btn btn-text close"
                  aria-label="Close"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    fill="currentColor"
                    class="main-nav-toggle-button-close bi bi-x-square"
                    viewBox="0 0 16 16"
                  >
                    <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z" />
                    <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708" />
                  </svg>
                </button>
              </div>

              <div
                id="contact-form-status-error"
                class="d-none alert alert-danger alert-dismissible"
                role="alert"
                aria-live="polite"
              >
                {getTranslation(t, 'contactFormError')}
                &nbsp;
                <a href="mailto:sanchezpizarro86@gmail.com" title="Email">
                  sanchezpizarro86@gmail.com
                </a>
                <button
                  id="contact-form-status-error-btn-close"
                  type="button"
                  class="btn-text close"
                  aria-label="Close"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    fill="currentColor"
                    class="main-nav-toggle-button-close bi bi-x-square"
                    viewBox="0 0 16 16"
                  >
                    <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z" />
                    <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708" />
                  </svg>
                </button>
              </div>
            </form>
          </div>
        </div>

        <div class="col-12 col-md-6">
          <ul>
            <li>
              <a
