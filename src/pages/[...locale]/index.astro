---
import BaseLayout from '@layouts/BaseLayout.astro';
import Divider from '@/components/Divider.astro';
import { getTranslation } from '@i18n/utils';
import About from '@/components/home/About.astro';
import Skills from '@/components/home/Skills.astro';
import Experiences from '@/components/home/Experiences.astro';
import Educations from '@/components/home/Educations.astro';
import Contact from '@/components/home/Contact.astro';

export { getStaticPaths } from '@i18n/utils';

const { t } = Astro.locals;
---

<BaseLayout
  title={getTranslation(t, 'meta.title')}
  description={getTranslation(t, 'meta.description')}
>
  <About />
  <Divider variant={1} />

  <Skills />
  <Divider variant={2} />

  <Experiences />
  <Divider variant={3} />

  <Educations />
  <Divider variant={4} />

  <Contact />
</BaseLayout>
