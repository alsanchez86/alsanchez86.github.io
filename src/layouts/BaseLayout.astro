---
import Head from '@components/Head.astro';
import Footer from '@components/Footer.astro';
import Nav from '@components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const { locale, t } = Astro.locals;
const pageTitle = title ?? t('metaTitle');
const pageDescription = description ?? t('metaDescription');
---

<!doctype html>
<html lang={locale}>
  <head>
    <Head title={pageTitle} description={pageDescription} />
  </head>

  <body>
    <header>
      <Nav />
    </header>

    <main class="main-wrapper">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<script>
  import $ from 'jquery';

  await import('bootstrap');

  const desktopQuery = window.matchMedia('(min-width: 768px)');

  function initPopovers() {
    $('[data-toggle="popover"]').popover({
      trigger: 'hover focus',
      offset: '0, 8px',
      container: 'body',
    });

    syncPopovers();
  }

  function syncPopovers() {
    const $popovers = $('[data-toggle="popover"]');

    if (desktopQuery.matches) {
      $popovers.popover('enable');
    } else {
      $popovers.popover('hide').popover('disable');
    }
  }

  initPopovers();
  desktopQuery.addEventListener('change', syncPopovers);
  document.addEventListener('astro:page-load', initPopovers);
  document.addEventListener('astro:before-swap', () => {
    $('[data-toggle="popover"]').popover('dispose');
  });
</script>
